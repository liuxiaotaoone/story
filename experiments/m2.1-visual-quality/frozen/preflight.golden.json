  "narrationSegments": [
    {
      "id": "narration-collision.segment.1",
      "narrationIntentId": "narration-collision",
      "shotId": "shot-collision",
      "sequence": 0,
      "text": "一只兔子慌忙穿过田野，砰的一声撞上了树桩。",
      "language": "zh-CN"
    },
    {
      "id": "narration-notice.segment.1",
      "narrationIntentId": "narration-notice",
      "shotId": "shot-notice",
      "sequence": 0,
      "text": "兔子倒在地上。",
      "language": "zh-CN"
    },
    {
      "id": "narration-notice.segment.2",
      "narrationIntentId": "narration-notice",
      "shotId": "shot-notice",
      "sequence": 1,
      "text": "农夫听见响声，转身看去。",
      "language": "zh-CN"
    },
    {
      "id": "narration-approach.segment.1",
      "narrationIntentId": "narration-approach",
      "shotId": "shot-approach",
      "sequence": 0,
      "text": "他快步走到树桩旁，弯下腰仔细查看。",
      "language": "zh-CN"
    },
    {
      "id": "narration-pickup.segment.1",
      "narrationIntentId": "narration-pickup",
      "shotId": "shot-pickup",
      "sequence": 0,
      "text": "农夫伸手抱起兔子，把它稳稳搂在怀里。",
      "language": "zh-CN"
    }
  ],
