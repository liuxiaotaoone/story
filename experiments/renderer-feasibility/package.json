{
  "name": "@pose-clip/renderer-feasibility",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node ../../node_modules/vitest/vitest.mjs run",
    "feasibility": "node scripts/run-feasibility.mjs --mode=swiftshader",
    "feasibility:gpu": "node scripts/run-feasibility.mjs --mode=gpu",
    "candidate:mp4": "node scripts/run-candidate-mp4.mjs",
    "candidate:tempo-comparison": "node scripts/run-tempo-comparison.mjs",
    "candidate:transition-mp4": "node scripts/run-transition-mp4.mjs --variant=100ms",
    "candidate:transition-67ms": "node scripts/run-transition-mp4.mjs --variant=67ms"
  },
  "dependencies": {
    "@pose-clip/paper-engine": "workspace:*",
    "@pose-clip/paper-pixi": "workspace:*",
    "@pose-clip/schemas": "workspace:*",
    "playwright-core": "1.62.1"
  },
  "devDependencies": {
    "vite": "8.2.1"
  }
}
